API_PORT=18000
WEB_PORT=13000
LASER_ADMIN_USERNAME=admin
# Set a unique password of at least 12 characters before first startup.
LASER_ADMIN_PASSWORD=
LASER_COOKIE_SECURE=false
# Comma-separated reverse-proxy IPs whose X-Forwarded-For header may be trusted.
LASER_TRUSTED_PROXIES=
CORS_ORIGINS=http://localhost:13000,http://127.0.0.1:13000
# Public filing footer, served by the API at runtime rather than embedded in source code.
LASER_ICP_NUMBER=
LASER_ICP_URL=https://beian.miit.gov.cn/
LASER_POLICE_NUMBER=
LASER_POLICE_URL=https://beian.mps.gov.cn/#/query/webSearch
# Models, API keys and prices are managed in the web administration panel.
# Model evaluation worker limits
LASER_EVALUATION_PER_USER=1
LASER_EVALUATION_GLOBAL_SLOTS=1
